{
  "version": "https://jsonfeed.org/version/1",
  "title": "{{ if eq  .Title  .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ .Site.Title }}{{ end }}",
  "home_page_url": "{{ .Site.BaseURL }}",
  "feed_url": "{{ .Permalink }}/index.json",
  "author": {
    "url": "https://micro.blog/chrisd",
    "name": "{{ .Site.Author.name }}"
  },
  "icon": "{{ .Site.BaseURL }}/apple-touch-icon.png",
  "favicon": "{{ .Site.BaseURL }}/favicon-32x32.png",
  "items": [{{ $length := len .Pages }}{{ range $index, $value := .Pages }}
    {
      {{ if ne .Type "note" }}"title": "{{ .Title }}",{{ end }}
      "date_published": "{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}",
      "date_updated": "{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}",
      "id": "{{ .Permalink }}",
      "url": "{{ .Permalink }}",
      "author": {
        "name": "{{ .Site.Author.name }}"
      },
      "content_html": "<p>{{ $baseurl := .Site.BaseURL }}{{ $categoryEmojis := .Site.Params.categoryEmoji }}{{ range .Params.categories }}{{ $category := . }}{{ range $name, $data := $categoryEmojis }}{{ if in $category $name }}<a href='{{ $baseurl }}{{ trim .url "/" }}'>{{ .icon }}</a>&nbsp;{{ end }}{{ end }}{{ end }}{{ $a := replace .Content "\n" "" }}{{ $b := replace $a "\"" "'" }}{{ $c := replace $b "\\d" "" }}{{- $c | markdownify -}}{{ with .Resources.ByType "image" }}{{ range . }}{{ $imageSmall := .Resize "600x png photo" }}<img src='{{ $imageSmall.Permalink }}' width='{{ $imageSmall.Width }}' height='{{ $imageSmall.Height }}' alt='' />{{ end }}{{ end }}</p>"
    }{{ if ne $length (add $index 1) }},{{ end }}
  {{ end }}]
}
