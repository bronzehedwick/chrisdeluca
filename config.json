{
  "paginate": 25,
  "pagination": {
    "pagerSize": 25
  },
  "rssLimit": 25,
  "services": {
    "rss": {
      "limit": 25
    }
  },
  "taxonomies": {
    "category": "categories"
  },
  "markup": {
    "goldmark": {
      "renderer": {
        "unsafe": true
      }
    }
  },
  "enableRobotsTXT": true,
  "pluralizeListTitles": false,
  "capitalizeListTitles": false,
  "ignoreLogs": ["warning-goldmark-raw-html"]
}
